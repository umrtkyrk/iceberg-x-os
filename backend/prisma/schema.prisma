datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  ADMIN
  MENTOR
  CUBE
}

enum CubeLevel {
  Cube
  Senior_Cube
  Former_Cube
  Iceberger
  Alumni
}

enum MissionStatus {
  idea_pool
  selected
  researching
  building_demo
  preparing_handover
  demo_ready
  pending_approval
  completed
  reviewed
  promoted_to_product_backlog
  archived
  cancelled
}

enum DifficultyLevel {
  Level_1_Research_Only
  Level_2_Research_Mock
  Level_3_Working_POC
  Level_4_Integration_Candidate
  Level_5_Main_Team_Assist
}

enum MissionDecision {
  Promote_to_Product_Backlog
  Needs_More_Research
  Keep_as_Internal_Tool
  Archive
  Moved_to_Product
}

enum TeamMemberRole {
  Mission_Lead
  Technical_Explorer
  Demo_Builder
  Documenter
  Presenter
  Contributor
}

enum UpdateType {
  daily
  weekly
  mission_progress
}

enum RecommendedNextStep {
  Continue_as_Cube
  Consider_for_Senior_Cube
  Consider_as_Former_Cube
  Consider_as_Iceberger
  Consider_as_Alumni
  Needs_Support
  Inactive_Risk
}

model User {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  password_hash String
  role          Role     @default(CUBE)
  avatar_url    String?
  last_login_at DateTime?
  login_streak  Int      @default(0)
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt

  forum_topics ForumTopic[]
  forum_replies ForumReply[]
  forum_states ForumTopicState[]
  forum_reports ForumReport[]
  forum_profile ForumProfile?

  // Relations
  cube_profile         CubeProfile?          @relation("UserToCubeProfile")
  assigned_cubes       CubeProfile[]         @relation("MentorToCube")
  created_missions     Mission[]             @relation("MissionCreator")
  assigned_missions    Mission[]             @relation("MissionMentor")
  updates              Update[]
  demo_submissions     DemoSubmission[]
  mentor_feedback      MentorFeedback[]      @relation("FeedbackMentor")
  cube_feedback        MentorFeedback[]      @relation("FeedbackCube")
  awarded_badges       CubeBadge[]           @relation("BadgeAwarder")
  presentations        DemoDayPresentation[]
  private_notes_created PrivateNote[]        @relation("NotesCreated")
  notifications        Notification[]       @relation("UserNotifications")
  invites              UserInvite[]         @relation("UserInvites")
  invites_created      UserInvite[]         @relation("InvitesCreated")
  uploaded_documents   CubeDocument[]       @relation("DocumentUploader")
  reviewed_documents   CubeDocument[]       @relation("DocumentReviewer")
}

model CubeProfile {
  id                 String      @id @default(uuid())
  user_id            String      @unique
  user               User        @relation("UserToCubeProfile", fields: [user_id], references: [id], onDelete: Cascade)
  cube_number        String      @unique // e.g. "001", "002"
  cohort             String
  university         String
  department         String
  github_url         String?
  gitlab_url         String?
  linkedin_url       String?
  slack_handle       String?
  phone_number       String?
  skills             String[]
  interests          String[]
  current_level      CubeLevel   @default(Cube)
  internship_status  String?
  is_founding_cube   Boolean     @default(false)
  avatar_url         String?
  assigned_mentor_id String?
  assigned_mentor    User?       @relation("MentorToCube", fields: [assigned_mentor_id], references: [id], onDelete: SetNull)
  nda_signed         Boolean     @default(false)
  nda_signed_at      DateTime?
  nda_status         String      @default("not_sent")
  /// Set by staff to publicly mark a Cube as close to Senior Cube. Cleared
  /// automatically when they are promoted.
  is_senior_candidate Boolean    @default(false)
  /// When the Cube first reached the Iceberger level (null for those who got
  /// there before this was recorded).
  iceberger_at       DateTime?
  /// When an Iceberger was promoted to Mentor. The profile is kept as history.
  mentor_promoted_at DateTime?
  created_at         DateTime    @default(now())
  updated_at         DateTime    @updatedAt

  // Relations
  team_memberships   MissionTeamMember[]
  mission_contributions MissionContributor[]
  cube_badges        CubeBadge[]
  meeting_attendance MeetingAttendance[]
  offboarding_record OffboardingRecord?
  private_notes      PrivateNote[]
  testimonials       Testimonial[]
  cube_quests        CubeQuest[]
  documents          CubeDocument[]
  quiz_attempts      QuizAttempt[]
  peer_feedback_received PeerFeedback[]       @relation("PeerFeedbackReceived")
  peer_signal            PeerSignal?          @relation("PeerSignalCube")
  peer_growth_signals    PeerGrowthSignal[]   @relation("PeerGrowthCube")
  peer_titles            PeerTitle[]          @relation("PeerTitleCube")
  mvcubes_awards         MvcubesAward[]       @relation("MvcubesCube")

  @@index([assigned_mentor_id])
  @@index([current_level])
  @@index([nda_signed])
  @@index([nda_status])
}

model Mission {
  forum_contexts ForumTopicContext[]
  id                 String                @id @default(uuid())
  title              String
  description        String
  context            String
  problem_statement  String
  expected_output    String
  difficulty_level   DifficultyLevel
  status             MissionStatus         @default(idea_pool)
  category           String                @default("General")
  created_by_id      String
  created_by         User                  @relation("MissionCreator", fields: [created_by_id], references: [id])
  mentor_id          String?
  mentor             User?                 @relation("MissionMentor", fields: [mentor_id], references: [id])
  slack_channel_url  String?
  repository_url     String?
  demo_url           String?
  decision           MissionDecision?
  created_at         DateTime              @default(now())
  updated_at         DateTime              @updatedAt

  // Relations
  teams              MissionTeam[]
  updates            Update[]
  demo_submissions   DemoSubmission[]
  mentor_feedbacks   MentorFeedback[]
  cube_badges        CubeBadge[]
  presentations      DemoDayPresentation[]
  contributors       MissionContributor[]
  predecessor_links  MissionLink[]         @relation("MissionPredecessors")
  followup_links     MissionLink[]         @relation("MissionFollowUps")

  @@index([status])
  @@index([mentor_id])
  @@index([updated_at])
}

/// "This mission continues that one." A mission can follow several earlier
/// missions (e.g. ones in the Vault), and one mission can have many follow-ups.
model MissionLink {
  id             String   @id @default(uuid())
  mission_id     String
  mission        Mission  @relation("MissionPredecessors", fields: [mission_id], references: [id], onDelete: Cascade)
  predecessor_id String
  predecessor    Mission  @relation("MissionFollowUps", fields: [predecessor_id], references: [id], onDelete: Cascade)
  created_at     DateTime @default(now())

  @@unique([mission_id, predecessor_id])
  @@index([predecessor_id])
}

/// Durable "who worked on this mission" history. Team rosters get edited,
/// detached and deleted; this table keeps the record. `released_at` is set when
/// a Cube leaves the mission instead of the row being removed.
model MissionContributor {
  id          String         @id @default(uuid())
  mission_id  String
  mission     Mission        @relation(fields: [mission_id], references: [id], onDelete: Cascade)
  cube_id     String
  cube        CubeProfile    @relation(fields: [cube_id], references: [id], onDelete: Cascade)
  role        TeamMemberRole @default(Contributor)
  team_name   String?        // team they were on, kept after the team is deleted
  assigned_at DateTime       @default(now())
  released_at DateTime?
  updated_at  DateTime       @updatedAt

  @@unique([mission_id, cube_id])
  @@index([cube_id])
}

model MissionTeam {
  id         String      @id @default(uuid())
  mission_id String?
  mission    Mission?     @relation(fields: [mission_id], references: [id], onDelete: SetNull)
  name       String
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt

  // Relations
  members            MissionTeamMember[]
  demo_submissions   DemoSubmission[]
  presentations      DemoDayPresentation[]

  @@index([mission_id])
}

model MissionTeamMember {
  id                   String         @id @default(uuid())
  team_id              String
  team                 MissionTeam    @relation(fields: [team_id], references: [id], onDelete: Cascade)
  cube_id              String
  cube                 CubeProfile    @relation(fields: [cube_id], references: [id], onDelete: Cascade)
  role                 TeamMemberRole @default(Contributor)
  what_gained          String?        // Ne aldığını
  what_learned         String?        // Ne öğrendiğini
  what_could_be_better String?        // Neyi daha iyi yapabileceğini
  is_submitted         Boolean        @default(false)
  submitted_at         DateTime?
  created_at           DateTime       @default(now())
  updated_at           DateTime       @updatedAt

  @@unique([team_id, cube_id])
  @@index([cube_id])
}

model Update {
  id         String     @id @default(uuid())
  cube_id    String
  cube       User       @relation(fields: [cube_id], references: [id], onDelete: Cascade)
  mission_id String
  mission    Mission    @relation(fields: [mission_id], references: [id], onDelete: Cascade)
  type       UpdateType
  content    String
  blockers   String?
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt

  @@index([mission_id, created_at])
  @@index([cube_id])
}

model DemoSubmission {
  id                            String                @id @default(uuid())
  mission_id                    String
  mission                       Mission               @relation(fields: [mission_id], references: [id], onDelete: Cascade)
  team_id                       String?
  team                          MissionTeam?          @relation(fields: [team_id], references: [id], onDelete: SetNull)
  submitted_by_id               String
  submitted_by                  User                  @relation(fields: [submitted_by_id], references: [id])
  title                         String
  summary                       String
  what_we_built                 String
  what_we_learned               String
  what_worked_well              String
  what_could_we_have_done_better String
  recommendation                String?
  repository_url                String?
  pull_request_url              String?
  demo_url                      String?
  document_url                  String?
  video_url                     String?
  submitted_at                  DateTime              @default(now())
  created_at                    DateTime              @default(now())
  updated_at                    DateTime              @updatedAt

  // Relations
  presentations                 DemoDayPresentation[]

  @@index([mission_id])
  @@index([submitted_by_id])
  @@index([team_id])
}

model MentorFeedback {
  id                       String              @id @default(uuid())
  cube_id                  String
  cube                     User                @relation("FeedbackCube", fields: [cube_id], references: [id], onDelete: Cascade)
  mission_id               String?
  mission                  Mission?            @relation(fields: [mission_id], references: [id], onDelete: Cascade)
  mentor_id                String
  mentor                   User                @relation("FeedbackMentor", fields: [mentor_id], references: [id], onDelete: Cascade)
  technical_ability_score  Int
  research_ability_score   Int
  demo_output_score        Int
  ownership_score          Int
  communication_score      Int
  leadership_score         Int
  product_thinking_score   Int
  reliability_score        Int
  self_reflection_score    Int
  strengths                String
  areas_to_improve         String
  private_notes            String?
  visible_to_cube          Boolean             @default(false)
  recommended_next_step    RecommendedNextStep
  created_at               DateTime            @default(now())
  updated_at               DateTime            @updatedAt

  @@unique([cube_id, mission_id, mentor_id])
  @@index([mentor_id])
  @@index([mission_id])
  @@index([recommended_next_step])
}

/// How hard a badge is to earn. Drives the frame and treatment it is shown with.
enum BadgeRarity {
  Common
  Rare
  Epic
  /// Appended last on purpose: Postgres orders enum values by declaration, so
  /// `orderBy rarity desc` lists Legendary first. Added with ALTER TYPE ... ADD
  /// VALUE, which touches no row.
  Legendary
}

model Badge {
  id          String      @id @default(uuid())
  name        String      @unique
  description String
  icon        String      // Icon key from the badge icon catalogue
  rarity      BadgeRarity @default(Common)
  /// Optional accent colour key; falls back to the rarity's own palette.
  accent      String?
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  // Relations
  cube_badges   CubeBadge[]
  quests        Quest[]       @relation("QuestToBadge")
  quiz_attempts QuizAttempt[]

  @@index([rarity])
}

model CubeBadge {
  id            String      @id @default(uuid())
  cube_id       String
  cube          CubeProfile @relation(fields: [cube_id], references: [id], onDelete: Cascade)
  badge_id      String
  badge         Badge       @relation(fields: [badge_id], references: [id], onDelete: Cascade)
  mission_id    String?
  mission       Mission?    @relation(fields: [mission_id], references: [id], onDelete: SetNull)
  awarded_by_id String
  awarded_by    User        @relation("BadgeAwarder", fields: [awarded_by_id], references: [id])
  reason        String
  awarded_at    DateTime    @default(now())

  @@index([cube_id])
  @@index([badge_id])
  @@index([mission_id])
  @@index([awarded_at])
}

model DemoDay {
  id          String                @id @default(uuid())
  title       String
  date        DateTime
  description String?
  created_at  DateTime              @default(now())
  updated_at  DateTime              @updatedAt

  // Relations
  presentations DemoDayPresentation[]
}

model DemoDayPresentation {
  id                 String          @id @default(uuid())
  demo_day_id        String
  demo_day           DemoDay         @relation(fields: [demo_day_id], references: [id], onDelete: Cascade)
  mission_id         String
  mission            Mission         @relation(fields: [mission_id], references: [id], onDelete: Cascade)
  team_id            String?
  team               MissionTeam?    @relation(fields: [team_id], references: [id], onDelete: SetNull)
  presenter_id       String
  presenter          User            @relation(fields: [presenter_id], references: [id])
  demo_submission_id String?
  demo_submission    DemoSubmission? @relation(fields: [demo_submission_id], references: [id], onDelete: SetNull)
  decision           String?
  mentor_summary     String?
  created_at         DateTime        @default(now())
  updated_at         DateTime        @updatedAt

  @@index([demo_day_id])
  @@index([mission_id])
  @@index([presenter_id])
}

model CubeApplication {
  id            String   @id @default(uuid())
  name          String
  email         String   @unique
  university    String
  degree        String
  year_of_study String
  why_join      String   @db.Text
  linkedin_url  String?
  github_url    String?
  status        String   @default("pending") // pending, approved, rejected
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}
model Meeting {
  id           String              @id @default(uuid())
  title        String
  description  String?             @db.Text
  date         DateTime
  is_completed Boolean             @default(false)
  decisions    String?             @db.Text
  summary      String?             @db.Text
  created_at       DateTime            @default(now())
  updated_at       DateTime            @updatedAt
  invited_cube_ids String[]

  // Relations
  attendance   MeetingAttendance[]
}

model MeetingAttendance {
  id         String      @id @default(uuid())
  meeting_id String
  meeting    Meeting     @relation(fields: [meeting_id], references: [id], onDelete: Cascade)
  cube_id    String
  cube       CubeProfile @relation(fields: [cube_id], references: [id], onDelete: Cascade)
  attended   Boolean     @default(true)
  excuse     String?     @db.Text
  created_at DateTime    @default(now())
  updated_at DateTime    @updatedAt

  @@unique([meeting_id, cube_id])
  @@index([cube_id])
}

model OffboardingRecord {
  id             String      @id @default(uuid())
  cube_id        String      @unique
  cube           CubeProfile @relation(fields: [cube_id], references: [id], onDelete: Cascade)
  certificate_no String      @unique // e.g., "ICE-2026-000047"
  type           String      // "success" or "participation"
  mentor_name    String
  issue_date     DateTime    @default(now())
  email_text_tr  String      @db.Text
  email_text_en  String      @db.Text
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt
}

model PrivateNote {
  id             String      @id @default(uuid())
  cube_id        String
  cube           CubeProfile @relation(fields: [cube_id], references: [id], onDelete: Cascade)
  created_by_id  String
  created_by     User        @relation("NotesCreated", fields: [created_by_id], references: [id], onDelete: Cascade)
  subject        String
  note           String      @db.Text
  score          Int?
  created_at     DateTime    @default(now())
  updated_at     DateTime    @updatedAt

  @@index([cube_id, created_at])
  @@index([created_by_id])
}

model Notification {
  forum_target ForumNotificationTarget?
  id         String   @id @default(uuid())
  user_id    String
  user       User     @relation("UserNotifications", fields: [user_id], references: [id], onDelete: Cascade)
  message    String   @db.Text
  created_at DateTime @default(now())
  read_at    DateTime?

  @@index([user_id, created_at])
  @@index([user_id, read_at])
}

/// One-time invitation used to onboard a new user without a shared password.
///
/// This is a NEW table. No existing table or row is touched: users already
/// created with DEFAULT_CUBE_PASSWORD keep their password_hash and can keep
/// signing in exactly as before.
model UserInvite {
  id          String    @id @default(uuid())
  user_id     String
  user        User      @relation("UserInvites", fields: [user_id], references: [id], onDelete: Cascade)
  /// SHA-256 of the raw token. The raw value is shown to the admin once and
  /// never stored, so a database leak cannot be replayed as an invite link.
  token_hash  String    @unique
  expires_at  DateTime
  accepted_at DateTime?
  created_by_id String
  created_by  User      @relation("InvitesCreated", fields: [created_by_id], references: [id], onDelete: Cascade)
  created_at  DateTime  @default(now())

  @@index([user_id])
  @@index([expires_at])
}

model Testimonial {
  id          String      @id @default(uuid())
  cube_id     String
  cube        CubeProfile @relation(fields: [cube_id], references: [id], onDelete: Cascade)
  content     String      @db.Text
  is_approved Boolean     @default(false)
  created_at  DateTime    @default(now())
  updated_at  DateTime    @updatedAt

  @@index([cube_id])
  @@index([is_approved, created_at])
}

model Quest {
  forum_contexts ForumTopicContext[]
  id                  String      @id @default(uuid())
  title               String
  description         String      @db.Text
  difficulty          BadgeRarity @default(Common)
  criteria_type       String
  criteria_value      Float
  /// For "rate" criteria (average_score, meeting_attendance) only: the minimum
  /// number of underlying records (feedback entries / meetings) the rate must be
  /// computed over before the quest can complete. Without this, a Cube's very
  /// first meeting attendance is trivially "100%". Null means the service falls
  /// back to a per-difficulty default. Unused by count-based criteria types
  /// (missions_completed, etc.), where criteria_value already is the count.
  min_sample_size     Int?
  is_timed            Boolean     @default(false)
  expires_at          DateTime?
  /// When true the quest is assigned automatically to every eligible Cube (see
  /// ensureAutoQuestsForCube). Defaults to false, so every existing quest keeps
  /// its current manual-assignment behaviour.
  auto_assign         Boolean     @default(false)
  created_at          DateTime    @default(now())
  updated_at          DateTime    @updatedAt

  dependency_quest_id String?
  dependency_quest    Quest?      @relation("QuestDependency", fields: [dependency_quest_id], references: [id], onDelete: SetNull)
  dependent_quests    Quest[]     @relation("QuestDependency")

  // Relations
  rewards             Badge[]     @relation("QuestToBadge")
  cube_quests         CubeQuest[]

  @@index([difficulty])
  @@index([criteria_type])
  @@index([dependency_quest_id])
}

model CubeQuest {
  id            String      @id @default(uuid())
  cube_id       String
  cube          CubeProfile @relation(fields: [cube_id], references: [id], onDelete: Cascade)
  quest_id      String
  quest         Quest       @relation(fields: [quest_id], references: [id], onDelete: Cascade)
  current_value Float       @default(0)
  is_completed  Boolean     @default(false)
  completed_at  DateTime?
  assigned_at   DateTime    @default(now())
  updated_at    DateTime    @updatedAt

  @@unique([cube_id, quest_id])
  @@index([cube_id])
  @@index([quest_id])
}

enum DocumentType {
  NDA
  STUDENT_CERTIFICATE
  TRANSCRIPT
  INTERNSHIP_CONTRACT
  SGK_ENTRY
  ID_COPY
  OTHER
}

enum DocumentStatus {
  PENDING_REVIEW
  APPROVED
  REJECTED
}

model CubeDocument {
  id             String         @id @default(uuid())
  cube_id        String
  cube           CubeProfile    @relation(fields: [cube_id], references: [id], onDelete: Cascade)
  type           DocumentType   @default(OTHER)
  title          String
  file_name      String
  file_path      String
  file_size      Int
  mime_type      String
  status         DocumentStatus @default(PENDING_REVIEW)
  notes          String?
  uploaded_by_id String
  uploaded_by    User           @relation("DocumentUploader", fields: [uploaded_by_id], references: [id], onDelete: Restrict)
  reviewed_by_id String?
  reviewed_by    User?          @relation("DocumentReviewer", fields: [reviewed_by_id], references: [id], onDelete: SetNull)
  reviewed_at    DateTime?
  created_at     DateTime       @default(now())
  updated_at     DateTime       @updatedAt

  @@index([cube_id])
  @@index([type])
  @@index([status])
  @@index([uploaded_by_id])
}

model QuizAttempt {
  id               String       @id @default(uuid())
  cube_id          String
  cube             CubeProfile  @relation(fields: [cube_id], references: [id], onDelete: Cascade)
  score            Int          @default(0) // 0 - 100
  correct_count    Int          @default(0) // 0 - 25
  wrong_count      Int          @default(0) // 0 - 25
  hint_penalty     Int          @default(0)
  duration_seconds Int?
  questions        Json         // Snapshot of questions given to the Cube (without answer key)
  answer_key       Json         // Stored server-side correct answers & matching pairs for this attempt
  user_answers     Json?        // Selected answers submitted by the Cube
  hints_used       Json?        // Question indices where hint was unlocked
  status           String       @default("in_progress") // "in_progress", "completed", "timed_out"
  badge_awarded_id String?
  badge_awarded    Badge?       @relation(fields: [badge_awarded_id], references: [id], onDelete: SetNull)
  started_at       DateTime     @default(now())
  completed_at     DateTime?

  @@index([cube_id])
  @@index([status])
  @@index([completed_at])
  @@index([score])
}

// ─────────────────────────────────────────────────────────────────────────────
// Peer feedback, Radar and MVCubes.
//
// Everything below is NEW. No existing table is modified by these models (the
// only change to an existing table is Quest.auto_assign above).
// ─────────────────────────────────────────────────────────────────────────────

enum PeerFeedbackKind {
  KUDOS
  OBSERVATION
  CONCERN
}

enum PeerFeedbackStatus {
  ACTIVE
  DISMISSED
}

enum PeerContextType {
  MISSION
  MEETING
  TEAM
  OTHER
}

enum PeerSignalState {
  OPEN
  IN_CONVERSATION
  RESOLVED
}

/// One piece of peer feedback.
///
/// `giver_hash` is a keyed HMAC of the giver's user id and is deliberately NOT a
/// foreign key: nothing in the schema can join this row back to a User. It
/// exists only for rate limits, normalisation and abuse detection, and is never
/// returned by any endpoint.
model PeerFeedback {
  id           String             @id @default(uuid())
  giver_hash   String
  receiver_id  String
  receiver     CubeProfile        @relation("PeerFeedbackReceived", fields: [receiver_id], references: [id], onDelete: Cascade)
  kind         PeerFeedbackKind
  tags         String[]
  note         String?            @db.Text
  context_type PeerContextType    @default(OTHER)
  context_id   String?
  /// Context weight, frozen at write time.
  weight       Float              @default(1)
  status       PeerFeedbackStatus @default(ACTIVE)
  /// Kudos only: set by the weekly digest. Null until the recipient may see it.
  delivered_at DateTime?
  is_pinned    Boolean            @default(false)
  pinned_at    DateTime?
  /// Receiver had fewer than 3 distinct givers when this was written.
  was_quiet    Boolean            @default(false)
  /// Set by the receiver when the feedback was useful.
  helpful_at   DateTime?
  created_at   DateTime           @default(now())

  @@index([receiver_id, kind, created_at])
  @@index([giver_hash, created_at])
  @@index([receiver_id, is_pinned])
}

/// Cached aggregate per Cube. Recomputed on write; the only peer data mentors read.
model PeerSignal {
  id                String      @id @default(uuid())
  cube_id           String      @unique
  cube              CubeProfile @relation("PeerSignalCube", fields: [cube_id], references: [id], onDelete: Cascade)
  kudos_score       Float       @default(0)
  concern_score     Float       @default(0)
  distinct_givers   Int         @default(0)
  distinct_contexts Int         @default(0)
  tag_counts        Json        @default("{}")
  /// Peer positive signal relative to mentor-side visibility (Hidden Gems).
  visibility_gap    Float       @default(0)
  updated_at        DateTime    @updatedAt
}

/// A verified growth signal awaiting, or undergoing, a mentor conversation.
model PeerGrowthSignal {
  id            String          @id @default(uuid())
  cube_id       String
  cube          CubeProfile     @relation("PeerGrowthCube", fields: [cube_id], references: [id], onDelete: Cascade)
  /// Broad category only: Communication, Contribution, Reliability, Collaboration.
  category      String
  state         PeerSignalState @default(OPEN)
  due_at        DateTime
  handled_by_id String?
  handled_at    DateTime?
  created_at    DateTime        @default(now())

  @@index([cube_id, state])
  @@index([state, due_at])
}

/// Peer-earned title. The tier upgrades in place and is never lowered.
model PeerTitle {
  id          String      @id @default(uuid())
  cube_id     String
  cube        CubeProfile @relation("PeerTitleCube", fields: [cube_id], references: [id], onDelete: Cascade)
  category    String
  rarity      BadgeRarity
  earned_at   DateTime    @default(now())
  upgraded_at DateTime?

  @@unique([cube_id, category])
  @@index([category, rarity])
}

/// Monthly category winners shown on the MVCubes shelf.
model MvcubesAward {
  id       String      @id @default(uuid())
  period   String
  category String
  cube_id  String
  cube     CubeProfile @relation("MvcubesCube", fields: [cube_id], references: [id], onDelete: Cascade)
  note     String?

  @@unique([period, category, cube_id])
  @@index([period])
  @@index([cube_id])
}

/// Per-reviewer reliability weight used by the abuse pass. Keyed by giver_hash.
model PeerReviewerStat {
  giver_hash  String   @id
  reliability Float    @default(1)
  given_total Int      @default(0)
  dismissed   Int      @default(0)
  confirmed   Int      @default(0)
  updated_at  DateTime @updatedAt
}

model ForumCategory {
  id String @id
  name String
  description String
  position Int
  staff_only Boolean @default(false)
  topics ForumTopic[]
}

model ForumTopic {
  context ForumTopicContext?
  notification_targets ForumNotificationTarget[]
  id String @id @default(uuid())
  category_id String
  category ForumCategory @relation(fields: [category_id], references: [id])
  author_id String?
  author User? @relation(fields: [author_id], references: [id], onDelete: SetNull)
  title String @db.VarChar(160)
  body String @db.Text
  pinned Boolean @default(false)
  locked Boolean @default(false)
  accepted_reply_id String? @unique
  accepted_reply ForumReply? @relation("AcceptedForumReply", fields: [accepted_reply_id], references: [id], onDelete: SetNull)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  last_activity_at DateTime @default(now())
  deleted_at DateTime?
  deleted_by_id String?
  replies ForumReply[]
  states ForumTopicState[]
  reports ForumReport[]
  @@index([category_id, deleted_at, last_activity_at])
  @@index([author_id])
  @@index([deleted_at, pinned, last_activity_at])
}

model ForumReply {
  notification_targets ForumNotificationTarget[]
  id String @id @default(uuid())
  topic_id String
  topic ForumTopic @relation(fields: [topic_id], references: [id])
  author_id String?
  author User? @relation(fields: [author_id], references: [id], onDelete: SetNull)
  body String @db.Text
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt
  deleted_at DateTime?
  deleted_by_id String?
  reports ForumReport[]
  accepted_in ForumTopic? @relation("AcceptedForumReply")
  @@index([topic_id, deleted_at, created_at])
  @@index([author_id])
}

model ForumTopicState {
  user_id String
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  topic_id String
  topic ForumTopic @relation(fields: [topic_id], references: [id], onDelete: Cascade)
  saved Boolean @default(false)
  following Boolean @default(false)
  read_at DateTime?
  @@id([user_id, topic_id])
  @@index([topic_id])
}

model ForumReport {
  id String @id @default(uuid())
  reporter_id String?
  reporter User? @relation(fields: [reporter_id], references: [id], onDelete: SetNull)
  topic_id String
  topic ForumTopic @relation(fields: [topic_id], references: [id])
  reply_id String?
  reply ForumReply? @relation(fields: [reply_id], references: [id])
  reason String @db.VarChar(1000)
  created_at DateTime @default(now())
  resolved_at DateTime?
  resolved_by_id String?
  @@index([topic_id])
  @@index([reply_id])
  @@index([reporter_id])
  @@index([resolved_at, created_at])
}

// New tables only: existing portal data stays untouched.
model ForumProfile {
  user_id String @id
  user User @relation(fields: [user_id], references: [id], onDelete: Cascade)
  signature String @default("") @db.VarChar(140)
  badge_ids String[] @default([])
  updated_at DateTime @updatedAt
}
model ForumTopicContext {
  edited_at DateTime?
  topic_id String @id
  topic ForumTopic @relation(fields: [topic_id], references: [id], onDelete: Cascade)
  quest_id String?
  quest Quest? @relation(fields: [quest_id], references: [id], onDelete: SetNull)
  mission_id String?
  mission Mission? @relation(fields: [mission_id], references: [id], onDelete: SetNull)
  @@index([quest_id])
  @@index([mission_id])
}
model ForumNotificationTarget {
  notification_id String @id
  notification Notification @relation(fields: [notification_id], references: [id], onDelete: Cascade)
  topic_id String
  topic ForumTopic @relation(fields: [topic_id], references: [id], onDelete: Cascade)
  reply_id String?
  reply ForumReply? @relation(fields: [reply_id], references: [id], onDelete: SetNull)
  @@index([topic_id])
  @@index([reply_id])
}
