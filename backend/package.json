{
  "name": "iceberg-x-os-backend",
  "version": "1.0.0",
  "description": "Backend API for Iceberg X OS",
  "main": "dist/index.js",
  "scripts": {
    "clean": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc",
    "test": "node tests/run.cjs",
    "test:forum": "node tests/forum.run.cjs",
    "start": "node dist/index.js",
    "dev": "tsnd --respawn --transpile-only src/index.ts",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "test:forum:flag": "node tests/forum.disabled.cjs",
    "test:forum:db": "node tests/forum.database.cjs"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.10.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.3.0",
    "openai": "^4.28.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.24",
    "prisma": "^5.10.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
