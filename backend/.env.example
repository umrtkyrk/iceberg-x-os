DATABASE_URL="postgresql://iceberg:iceberg_password@localhost:5432/iceberg_x_db?schema=public"
# Direct local database connection for Prisma migrations (same as DATABASE_URL locally).
DIRECT_URL="postgresql://iceberg:iceberg_password@localhost:5432/iceberg_x_db?schema=public"
JWT_SECRET="super_secret_jwt_key_iceberg_x"
OPENAI_API_KEY="your_openai_api_key_here"
APP_URL="http://localhost:5173"
NODE_ENV="development"
PORT=5001
SLACK_WORKSPACE_URL="https://slack.com"
DEFAULT_GIT_PROVIDER="github_or_gitlab"

# Seed & Test Passwords
SEED_STAFF_PASSWORD="passwd123456"
SEED_CUBE_PASSWORD="passwd123456"
SEED_YUNUS_PASSWORD="passwd123456"

# Enable after applying the additive forum migration.
FORUM_ENABLED=false
# Encrypts private forum rooms at rest. 32 random bytes as base64; keep a backup, losing it makes rooms unreadable.
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FORUM_CHAT_KEY=
# Room GitHub activity supports public repositories only and never forwards server credentials.

# Scoring v2: Cubes see their v2 score and v2 quests can progress. Keep false until go-live.
SCORING_V2_LIVE=false
