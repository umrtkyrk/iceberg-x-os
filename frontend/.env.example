# Real Cube Forum API. Requires FORUM_ENABLED=true on the backend.
VITE_CUBE_FORUM_ENABLED=false

# Light/dark theme toggle in the workspace account menu.
VITE_DARK_THEME_ENABLED=false

# "Your focus" panel on the Cube dashboard.
VITE_CUBE_FOCUS_ENABLED=false

# File attachments (images, PDF, DOCX) on updates and demo submissions.
VITE_ATTACHMENTS_ENABLED=false

# "My Cubes" signals panel on the mentor dashboard.
VITE_MENTOR_CUBES_ENABLED=false

# Scoring v2 admin screens (disciplines, rubrics). See docs/scoring-v2.md.
VITE_SCORING_V2_ENABLED=false

# Scoring v2 go-live for Cubes (with SCORING_V2_LIVE=true on the backend).
VITE_SCORING_V2_LIVE=false
